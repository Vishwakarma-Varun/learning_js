{
    "name": "Node.js",

    "image": "mcr.microsoft.com/devcontainers/javascript-node:5-24-trixie",

    "customizations": {
        "vscode": {
            "extensions": [
                "esbenp.prettier-vscode",
                "vscode-icons-team.vscode-icons",
                "wayou.vscode-todo-highlight"
            ],
            "settings": {
                "editor.fontSize": 18,
                "terminal.integrated.fontSize": 16,
                "editor.wordWrap": "on"
            }
        }
    }
}